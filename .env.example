# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

# --- Database (MongoDB) ---
# Local MongoDB (installed via `mongod` or Docker):
# MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=safeher

# MongoDB Atlas (cloud, free tier works fine) — comment the line above and
# uncomment this one instead, filling in your own credentials:
MONGODB_URL=mongodb+srv://safeherAiUser:safehere12345@cluster0.8qu8yqx.mongodb.net/?appName=Cluster0

# --- Email (SMTP) used for trusted-contact notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=SafeHer AI <no-reply@safeher.ai>

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Optional AI Assistant (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Google Drive (optional, for emergency evidence backup) ---
GOOGLE_DRIVE_CLIENT_JSON=
GOOGLE_DRIVE_TOKEN_JSON=

# --- Media storage ---
MEDIA_ROOT=app/media
PUBLIC_BASE_URL=http://localhost:8000
