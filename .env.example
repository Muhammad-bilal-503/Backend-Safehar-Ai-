# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

# --- Database (defaults to local SQLite, swap for Postgres in production) ---
DATABASE_URL=sqlite:///./safeher.db

# --- Email (SMTP) used for trusted-contact notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=SafeHer AI <no-reply@safeher.ai>

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Optional AI Assistant (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Media storage ---
MEDIA_ROOT=app/media
PUBLIC_BASE_URL=http://localhost:8000
